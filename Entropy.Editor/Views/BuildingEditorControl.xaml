<UserControl x:Class="Entropy.Editor.Views.BuildingEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:Entropy.Editor.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:BuildingsViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="New" Command="{Binding AddCommand}" Padding="8,2" Margin="0,0,4,0"/>
                <Button Content="Duplicate" Command="{Binding DuplicateCommand}" Padding="8,2" Margin="0,0,4,0"/>
                <Button Content="Delete" Command="{Binding DeleteCommand}" Padding="8,2"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding Defs}" SelectedItem="{Binding Selected}"
                     DisplayMemberPath="Id"/>
        </DockPanel>

        <DockPanel Grid.Column="1" Margin="0,0,8,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                    <Button Content="−" Click="OnZoomOut" Width="26" Padding="0,1"/>
                    <TextBlock Text="{Binding Zoom, StringFormat={}{0}x}"
                               VerticalAlignment="Center" Margin="6,0" MinWidth="24"
                               TextAlignment="Center"/>
                    <Button Content="+" Click="OnZoomIn" Width="26" Padding="0,1"/>
                </StackPanel>
                <TextBlock x:Name="PlaceHint" HorizontalAlignment="Left" Margin="12,0,0,0"
                           Foreground="#B8860B" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </DockPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PaintGrid" HorizontalAlignment="Left" VerticalAlignment="Top"
                              Background="Transparent"
                              MouseLeftButtonDown="PaintGrid_MouseLeftButtonDown"
                              MouseMove="PaintGrid_MouseMove"
                              MouseRightButtonDown="PaintGrid_MouseRightButtonDown">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Cells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="{Binding DataContext.CellPixels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Height="{Binding DataContext.CellPixels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Background="{Binding Fill}"
                                            BorderBrush="#2A2A2A" BorderThickness="0.5" Cursor="Pen">
                                            <Grid>
                                                <Image Source="{Binding Tile}" Stretch="Fill"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Consolas"
                                                           FontSize="{Binding DataContext.GlyphPixels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Foreground="{Binding GlyphBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="Collapsed">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tile}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Badge}" FontSize="10"
                                                           FontWeight="Bold" Foreground="Yellow"
                                                           Margin="1,0,0,0" HorizontalAlignment="Left"
                                                           VerticalAlignment="Top">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Badge}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <DockPanel Grid.Column="2" Margin="8,0,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Terrain (right-click grid to pick)"
                       FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ListBox DockPanel.Dock="Top" x:Name="TerrainPalette" Height="180"
                     SelectedItem="{Binding SelectedTerrain}"
                     ItemsSource="{Binding Workspace.Terrains}" Margin="0,0,0,12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <Border Width="18" Height="18"
                                    Background="{Binding Color, Converter={StaticResource Color4Brush}}"
                                    BorderBrush="#555" BorderThickness="1"/>
                            <TextBlock Text="{Binding Symbol, Converter={StaticResource Char}}"
                                       FontFamily="Consolas" Margin="6,0,4,0"/>
                            <TextBlock Text="{Binding Id}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="WidthBox" Width="40" Margin="0,0,4,0"/>
                <TextBlock Text="x" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="HeightBox" Width="40" Margin="0,0,4,0"/>
                <Button Content="Apply" Click="OnApplyResize" Padding="8,2"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Anchors" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <WrapPanel x:Name="AnchorPresets" Margin="0,0,0,6">
                    <ToggleButton Content="entry" Tag="entry" Click="OnPresetAnchor" Padding="8,2" Margin="0,0,4,4"/>
                    <ToggleButton Content="work" Tag="work" Click="OnPresetAnchor" Padding="8,2" Margin="0,0,4,4"/>
                    <ToggleButton Content="home" Tag="home" Click="OnPresetAnchor" Padding="8,2" Margin="0,0,4,4"/>
                    <ToggleButton Content="shelf" Tag="shelf" Click="OnPresetAnchor" Padding="8,2" Margin="0,0,4,4"/>
                    <ToggleButton Content="register" Tag="register" Click="OnPresetAnchor" Padding="8,2" Margin="0,0,4,4"/>
                    <ToggleButton Content="bed" Tag="bed" Click="OnPresetAnchor" Padding="8,2" Margin="0,0,4,4"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBox x:Name="AnchorNameBox" Width="90" Margin="0,0,4,0"/>
                    <Button Content="Add" Click="OnAddAnchor" Padding="8,2" Margin="0,0,4,0"/>
                    <Button Content="Delete" Click="OnDeleteAnchor" Padding="8,2"/>
                </StackPanel>
                <ListBox x:Name="AnchorList" Height="110" MinHeight="40"
                         ItemsSource="{Binding Selected.Anchors}" SelectedValuePath="Key"
                         DisplayMemberPath="Key"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
