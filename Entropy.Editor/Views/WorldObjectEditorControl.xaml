<UserControl x:Class="Entropy.Editor.Views.WorldObjectEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:Entropy.Editor.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:WorldObjectsViewModel, IsDesignTimeCreatable=False}"
             xmlns:palettes="clr-namespace:Entropy.Editor"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="160"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="New" Command="{Binding AddCommand}" Padding="8,2" Margin="0,0,4,0"/>
                <Button Content="Duplicate" Command="{Binding DuplicateCommand}" Padding="8,2" Margin="0,0,4,0"/>
                <Button Content="Delete" Command="{Binding DeleteCommand}" Padding="8,2"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding Defs}" SelectedItem="{Binding Selected}" DisplayMemberPath="Id"/>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
            <StackPanel DataContext="{Binding Selected}">
                <TextBlock Text="Identity" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/><RowDefinition Height="28"/>
                        <RowDefinition Height="28"/><RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Id" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Id}" Margin="0,1"/>

                    <TextBlock Grid.Row="1" Text="Name" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name}" Margin="0,1"/>

                    <TextBlock Grid.Row="2" Text="Symbol" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Width="40" HorizontalAlignment="Left"
                             Text="{Binding Symbol, Converter={StaticResource Char}}" Margin="0,1"/>

                    <TextBlock Grid.Row="3" Text="Color" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Width="160" HorizontalAlignment="Left"
                              ItemsSource="{x:Static palettes:EditorPalettes.ColorNames}"
                              SelectedItem="{Binding Color, Converter={StaticResource ColorName}}"/>

                    <TextBlock Grid.Row="4" Text="Description" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Description}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto" Margin="0,1"/>
                </Grid>

                <TextBlock Text="Interaction" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/><RowDefinition Height="28"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Container Slots" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Width="80" HorizontalAlignment="Left"
                             Text="{Binding ContainerSlots}" Margin="0,1"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Starter Items" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding StarterItems, Converter={StaticResource ItemIds}, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <TextBlock Text="Flags (container, bed, seat, walkable)" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <TextBox Text="{Binding Flags, Converter={StaticResource Flags}, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="2" Margin="8,0,0,0">
            <TextBlock Text="Sprite" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Image Source="{Binding PreviewImage}" Width="128" Height="128"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
                   HorizontalAlignment="Left"/>
            <TextBlock Text="Sprite key: furniture:&lt;id&gt;" Foreground="#888" FontSize="11" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
