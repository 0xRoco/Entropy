<UserControl x:Class="Entropy.Editor.Views.TerrainEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:palettes="clr-namespace:Entropy.Editor"
             xmlns:viewModels="clr-namespace:Entropy.Editor.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:TerrainViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="160"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock DockPanel.Dock="Top" Text="TERRAIN BROWSER" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource EditorMutedText}" Margin="0,0,0,6"/>
            <TextBox DockPanel.Dock="Top" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filter by ID, name, or description" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="New" Command="{Binding AddCommand}" Padding="8,2" Margin="0,0,4,0"/>
                <Button Content="Duplicate" Command="{Binding DuplicateCommand}" Padding="8,2" Margin="0,0,4,0"/>
                <Button Content="Delete" Command="{Binding DeleteCommand}" Padding="8,2"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="ID" Command="{Binding SortCommand}" CommandParameter="Id" Padding="6,2" Margin="0,0,4,0" ToolTip="Sort by ID"/>
                <Button Content="Name" Command="{Binding SortCommand}" CommandParameter="Name" Padding="6,2" ToolTip="Sort by name"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding VisibleDefs}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Id}"/>
                            <TextBlock Text="{Binding Name}" FontSize="10"
                                       Foreground="{StaticResource EditorMutedText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
            <StackPanel DataContext="{Binding Selected}">
                <TextBlock Text="Identity" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/><RowDefinition Height="28"/>
                        <RowDefinition Height="28"/><RowDefinition Height="28"/>
                        <RowDefinition Height="28"/><RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Id" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Id}" Margin="0,1"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name}" Margin="0,1"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Symbol" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Width="40" HorizontalAlignment="Left"
                             Text="{Binding Symbol, Converter={StaticResource Char}}" Margin="0,1"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Color" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Width="160" HorizontalAlignment="Left"
                              ItemsSource="{x:Static palettes:EditorPalettes.ColorNames}"
                              SelectedItem="{Binding Color, Converter={StaticResource ColorName}}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Background" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" Width="160" HorizontalAlignment="Left"
                              ItemsSource="{x:Static palettes:EditorPalettes.ColorNames}"
                              SelectedItem="{Binding Background, Converter={StaticResource ColorName}}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Category" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Category}" Margin="0,1"/>
                </Grid>

                <TextBlock Text="Physics" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/><RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Walkable" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding Walkable}" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Opaque" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Opaque}" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Move Cost" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left"
                             Text="{Binding MoveCost}" Margin="0,1"/>
                </Grid>

                <TextBlock Text="Flags (road, outdoor, indoor)" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <TextBox Text="{Binding Flags, Converter={StaticResource Flags}, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="2" Margin="8,0,0,0" Background="{StaticResource EditorSurfaceRaised}"
                BorderBrush="{StaticResource EditorBorder}" BorderThickness="1" Padding="10">
            <StackPanel>
                <TextBlock Text="SELECTED TERRAIN" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource EditorMutedText}"/>
                <TextBlock Text="{Binding Selected.Name}" FontSize="16" Margin="0,7,0,0"/>
                <TextBlock Text="{Binding Selected.Id}" Foreground="{StaticResource EditorAccent}" Margin="0,2,0,12"/>
                <TextBlock Text="SPRITE PREVIEW" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource EditorMutedText}" Margin="0,0,0,5"/>
            <Image Source="{Binding PreviewImage}" Width="128" Height="128"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
                   HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
