<Window x:Class="Entropy.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Entropy.Editor.Views"
        Title="Entropy Content Editor"
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#EEE" Padding="8,6"
                BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Open Folder…" Command="{Binding OpenFolderCommand}"
                            Padding="10,3" Margin="0,0,6,0"/>
                    <Button Content="Save All" Command="{Binding SaveAllCommand}"
                            Padding="10,3" Margin="0,0,6,0"/>
                    <Button Content="Validate" Command="{Binding ValidateCommand}"
                            Padding="10,3"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Margin="16,0,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="#444"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#FDE7E9" Padding="8,4"
                BorderBrush="#E0A0A6" BorderThickness="0,1,0,0"
                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
            <ListBox ItemsSource="{Binding ValidationErrors}" MaxHeight="120"
                     BorderThickness="0" Background="Transparent"
                     FontSize="12" Foreground="#902020"/>
        </Border>

        <TabControl Margin="4">
            <TabItem Header="Items">
                <views:ItemsEditorControl DataContext="{Binding Items}"/>
            </TabItem>
            <TabItem Header="Creatures">
                <views:CreatureEditorControl DataContext="{Binding Creatures}"/>
            </TabItem>
            <TabItem Header="Terrain">
                <views:TerrainEditorControl DataContext="{Binding Terrain}"/>
            </TabItem>
            <TabItem Header="Tilesets">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Defs}" SelectedItem="{Binding Selected}"
                             DisplayMemberPath="Id" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="Tileset editor coming soon."
                               Foreground="#888" VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Grid>
            </TabItem>
            <TabItem Header="Buildings">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Defs}" SelectedItem="{Binding Selected}"
                             DisplayMemberPath="Id" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="Building editor coming soon."
                               Foreground="#888" VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
