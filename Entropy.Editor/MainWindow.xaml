    <Window x:Class="Entropy.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Entropy.Editor.Views"
        Title="Entropy Content Editor"
        Height="820" Width="1380"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveAllCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ValidateCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding Maps.UndoMapCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding Maps.RedoMapCommand}"/>
    </Window.InputBindings>
    <Grid Background="{StaticResource EditorBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource EditorSurface}"
                BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ENTROPY" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource EditorAccent}" VerticalAlignment="Center"/>
                    <TextBlock Text="CONTENT EDITOR" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource EditorMutedText}" Margin="12,4,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBox Width="220" Margin="0,0,12,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search content by id or name"/>
                    <Button Content="Open Folder" Command="{Binding OpenFolderCommand}"/>
                    <Button Content="Reload" Command="{Binding ReloadContentCommand}"/>
                    <Button Content="Save All" Command="{Binding SaveAllCommand}"/>
                    <Button Content="Validate" Command="{Binding ValidateCommand}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource EditorSurface}"
                BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,0,1,0" Padding="12,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="8,0,8,20">
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource EditorMutedText}"/>
                    <TextBlock Text="Author and inspect game content" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding SectionsView}"
                         SelectedValuePath="Index"
                         SelectedValue="{Binding SelectedSectionIndex, Mode=TwoWay}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource EditorMutedText}" Margin="8,14,8,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="2" Background="{StaticResource EditorBackground}"
                        BorderBrush="{StaticResource EditorBorder}" BorderThickness="1" Padding="10" Margin="8,18,8,0"
                        HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="PROJECT STATUS" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource EditorMutedText}"/>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="4,0,4,8">
                <TextBlock Text="CONTENT WORKSPACE" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource EditorMutedText}" VerticalAlignment="Center"/>
                <TextBlock Text="  /  select a category to edit" FontSize="11"
                           Foreground="{StaticResource EditorMutedText}" VerticalAlignment="Center"/>
            </DockPanel>

            <TabControl x:Name="EditorTabs" Grid.Row="1"
                        SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}">
                <TabItem Header="Project">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20" MaxWidth="760">
                            <TextBlock Text="PROJECT" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource EditorAccent}"/>
                            <TextBlock Text="Content root and authoring status" Foreground="{StaticResource EditorMutedText}"
                                       Margin="0,4,0,20"/>
                            <Border Background="{StaticResource EditorSurfaceRaised}"
                                    BorderBrush="{StaticResource EditorBorder}" BorderThickness="1" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="CONTENT ROOT" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource EditorMutedText}"/>
                                    <TextBlock Text="{Binding Workspace.FolderPath}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="Open Folder" Command="{Binding OpenFolderCommand}"/>
                                        <Button Content="Reload" Command="{Binding ReloadContentCommand}"/>
                                        <Button Content="Save All" Command="{Binding SaveAllCommand}" Margin="0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                                       Foreground="{StaticResource EditorMutedText}" Margin="0,14,0,0"/>
                            <TextBlock Text="RECENT CONTENT ROOTS" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource EditorMutedText}" Margin="0,24,0,6"/>
                            <ListBox ItemsSource="{Binding RecentProjects}" MaxHeight="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" HorizontalContentAlignment="Left"
                                                Padding="8,5" Margin="0,1,0,1"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Maps"><views:MapEditorControl DataContext="{Binding Maps}"/></TabItem>
                <TabItem Header="World Objects"><views:WorldObjectEditorControl DataContext="{Binding WorldObjects}"/></TabItem>
                <TabItem Header="Building Templates"><views:BuildingEditorControl DataContext="{Binding Buildings}"/></TabItem>
                <TabItem Header="Items"><views:ItemsEditorControl DataContext="{Binding Items}"/></TabItem>
                <TabItem Header="Creatures"><views:CreatureEditorControl DataContext="{Binding Creatures}"/></TabItem>
                <TabItem Header="Terrain"><views:TerrainEditorControl DataContext="{Binding Terrain}"/></TabItem>
                <TabItem Header="Tilesets"><views:TilesetEditorControl DataContext="{Binding Tilesets}"/></TabItem>
                <TabItem Header="Diagnostics">
                    <Grid Background="{StaticResource EditorSurface}" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="DIAGNOSTICS" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource EditorAccent}"/>
                            <TextBlock Text="Validation results across the loaded content root"
                                       Foreground="{StaticResource EditorMutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Diagnostics}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Severity}" Foreground="{StaticResource EditorError}"
                                                   FontWeight="Bold"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Source}" Foreground="{StaticResource EditorAccent}"/>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource EditorText}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="{StaticResource EditorSurface}" BorderBrush="{StaticResource EditorBorder}"
                    BorderThickness="1" Padding="10" Margin="0,12,0,0"
                    Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock Text="VALIDATION" Foreground="{StaticResource EditorError}" FontWeight="Bold" Margin="0,0,14,0"/>
                    <ListBox ItemsSource="{Binding ValidationErrors}" MaxHeight="90"/>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource EditorSurface}"
                BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,1,0,0" Padding="16,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="Ready" Foreground="{StaticResource EditorMutedText}"/>
                <TextBlock Text="Ctrl+S  Save    F5  Validate" Foreground="{StaticResource EditorMutedText}" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
